  rotate([x_rotation, y_rotation, z_rotation]){
    linear_extrude(height = depth)
    polygon(points=[[-0.5 * width, -0.5 * height], [-0.5 * width, 0.5 * height], [0.5 * width, 0.5 * height], [0.5 * width, -0.5 * height]]);
  }
}

