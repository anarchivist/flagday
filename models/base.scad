module battery_clip(x, y, z, battery_pack_depth, x_rotate, y_rotate, z_rotate, show_stop, north_clip){
  translate([x,y,z]){
    //battery clips
    clip_width = 2;
    clip_top_width = 5;
    clip_height = 15;
    clip_depth = battery_pack_depth + 1;
    clip_inside_x_offset = 4;
    clip_offset = clip_height/2;
    rotate([x_rotate,y_rotate,z_rotate]){
      translate([0,0,0]){
        //upright
        translate([-clip_width/2,-clip_offset,0])
        cube([clip_width, clip_height, clip_depth], false);
        //top
        translate([-clip_width/2,-clip_offset,10])
        cube([clip_top_width, clip_height, clip_width], false);
        //channel
        translate([-clip_width/2,-clip_width/2,12])
        cube([5, 2, 4], false);        
        //stop upright
        if(show_stop){
          if(north_clip){
            translate([-5,-(clip_width/2)+3,0])
            cube([6, clip_width, clip_depth+3], false);
            //stop
            translate([-5,-(clip_width/2)+3,12])
            cube([clip_width, clip_width, 4], false);
          }
          else{
            translate([-5,(clip_width/2)-5,0])
            cube([6, clip_width, clip_depth+3], false);
            //stop
            translate([-5,(clip_width/2)-5,12])
            cube([clip_width, clip_width, 4], false);
          }
        }
      }
    }
  }
}

module paisley(width, height, depth, x_rotation, y_rotation, z_rotation, polygon) {
  if(debug){
    echo("width: ", width);
    echo("height: ", height);
    echo("depth: ", depth);
    echo("x_rotation: ", x_rotation);
    echo("y_rotation: ", y_rotation);
    echo("z_rotation: ", z_rotation);
